---

BasedOnStyle: Google
TabWidth: 4
IndentWidth: 4
ColumnLimit: 80

# Force parameters to wrap to a new line if they don't fit on one
AllowAllParametersOfDeclarationOnNextLine: false
BinPackParameters: false

# Always use spaces
UseTab: Never

# Align trailing macro backslashes to the right
AlignEscapedNewlines: Right

# Prevent clang-format from re-wrapping trailing comments inside macros
ReflowComments: false

# Keep inline macro comments aligned cleanly without forcing huge gaps
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# Align #define
AlignConsecutiveMacros: true

SortIncludes: true

# Preserve the order of include blocks
IncludeBlocks: Preserve