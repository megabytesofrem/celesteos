---
BasedOnStyle: LLVM
TabWidth: 4
IndentWidth: 4
ColumnLimit: 100

# Force wrapping of list elements and parameters
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false

# Strict rules against collapsing structural objects
AllowShortBlocksOnASingleLine: Never
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never

# Formatting for struct instances and types
BreakBeforeBraces: Custom
Cpp11BracedListStyle: true          # Modified: Enables modern layout engine for {}
AlignAfterOpenBracket: BlockIndent  # Added: Forces closing } onto its own line matching the start indent
BracedInitializerIndentWidth: 4     # Added: Matches your IndentWidth inside the struct block
BraceWrapping:
  AfterStruct: true
  AfterClass: true

# Clean spacing & clean macro alignment
UseTab: Never
AlignEscapedNewlines: Right
ReflowComments: false
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AlignConsecutiveAssignments: false
AlignConsecutiveMacros: true

SortIncludes: true
IncludeBlocks: Preserve