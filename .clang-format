---
BasedOnStyle: LLVM
TabWidth: 4
IndentWidth: 4
ColumnLimit: 110

# Force wrapping of list elements and parameters
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false

# Strict rules against collapsing structural objects
AllowShortBlocksOnASingleLine: Never
AllowShortEnumsDeclarationsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never

# Formatting for struct instances and types
BreakBeforeBraces: Custom
BraceWrapping:
  AfterStruct: true
  AfterClass: true
  SplitEmptyRecords: true

# Clean spacing & clean macro alignment
UseTab: Never
AlignEscapedNewlines: Right
ReflowComments: false
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AlignConsecutiveMacros: true

SortIncludes: true
IncludeBlocks: Preserve