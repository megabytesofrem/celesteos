{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CelesteOS (QEMU)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/celesteos.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "QEMU: debug",
            "postDebugTask": "QEMU: stop",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug CelesteOS (QEMU, break at kmain)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/celesteos.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "QEMU: debug",
            "postDebugTask": "QEMU: stop",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "description": "Break when the kernel reaches kmain",
                    "text": "-break-insert -h kmain"
                }
            ]
        }
    ]
}
