{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CelesteOS",
            "type": "shell",
            "command": "make iso",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "QEMU: debug",
            "type": "shell",
            "command": "make --no-print-directory qemu-debug & qemu=$!; until ss -ltn 'sport = :1234' | grep -q ':1234'; do kill -0 \"$qemu\" 2>/dev/null || exit 1; sleep 0.1; done; echo 'QEMU gdbstub ready'; wait \"$qemu\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "dependsOn": "Build CelesteOS",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "qemu",
                "pattern": {
                    "regexp": "^__qemu_never_matches__$"
                },
                "background": {
                    "activeBegin": true,
                    "beginsPattern": "^QEMU-DEBUG-START$",
                    "endsPattern": "^QEMU gdbstub ready$"
                }
            }
        },
        {
            "label": "QEMU: stop",
            "type": "shell",
            "command": "if [ -f build/qemu.pid ]; then kill \"$(cat build/qemu.pid)\" 2>/dev/null || true; rm -f build/qemu.pid; fi",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "presentation": {
                "reveal": "never"
            },
            "problemMatcher": []
        }
    ]
}
