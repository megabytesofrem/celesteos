; CelesteOS Master Syscall Definition Table
;
; Format:
;   number  type [metadata...] { return_type name(args...); }
; RETURNS_PORT marks a Mach trap whose result is a port name.

#include <mach/mach_types.h>
#include <ipc/mach_message.h>
#include <ipc/mach_traps.h>

; --- Mach Traps (Negative Traps) ---
-16 STD { kern_return_t mach_port_allocate_trap(mach_port_right_t right, mach_port_name_t *name); }
-18 STD { kern_return_t mach_port_deallocate_trap(mach_port_name_t name); }
-24 STD { kern_return_t mach_port_make_send_trap(mach_port_name_t receive_name, mach_port_name_t *send_name); }
-26 STD RETURNS_PORT { mach_port_name_t mach_reply_port(void); }
-27 STD RETURNS_PORT { mach_port_name_t thread_self_trap(void); }
-28 STD RETURNS_PORT { mach_port_name_t task_self_trap(void); }
-29 STD RETURNS_PORT { mach_port_name_t host_self_trap(void); }
-31 STD { mach_msg_return_t mach_msg_trap(mach_msg_header_t *msg, mach_msg_option_t option, mach_msg_size_t send_size, mach_msg_size_t rcv_size, mach_port_name_t rcv_name, mach_msg_timeout_t timeout, mach_port_name_t notify); }
-32 STD { mach_msg_return_t mach_msg_overwrite_trap(mach_msg_header_t *msg, mach_msg_option_t option, mach_msg_size_t send_size, mach_msg_size_t rcv_size, mach_port_name_t rcv_name, mach_msg_timeout_t timeout, mach_port_name_t notify, mach_msg_header_t *rcv_msg, mach_msg_size_t rcv_limit); }

; --- BSD System Calls (Offset by 0x2000000) ---
1 STD { void exit(int rval); }
2 STD { int fork(void); }
3 STD { ssize_t read(int fd, void *buf, size_t nbyte); }
4 STD { ssize_t write(int fd, const void *buf, size_t nbyte); }


; 5 STD { int open(const char *path, int flags, mode_t mode); }