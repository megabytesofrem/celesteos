# Toolchain & Executables
CC      := gcc
NASM    := nasm
LD      := ld
XORRISO := xorriso
QEMU    := qemu-system-x86_64
BASH    := bash
RUBY    ?= ruby

# Directories
BUILD_DIR := build
ISO_DIR   := $(BUILD_DIR)/iso_root
LIMINE_DIR:= $(BUILD_DIR)/limine

# Output Files
TARGET_ELF := $(BUILD_DIR)/celesteos.elf
TARGET_ISO := $(BUILD_DIR)/celesteos.iso

# Include Directories
INCLUDES := -I. \
            -Iinclude \
            -Ilib \
            -Ilib/stdlib \
            -Ikernel \
            -Ikernel/memory \
            -Ikernel/drivers \
            -Ikernel/asm

# Compiler & Assembler Flags
CFLAGS := -std=c17 \
          -ffreestanding \
          -mno-red-zone \
          -mcmodel=kernel \
          -mno-mmx \
          -mno-sse2 \
          -fno-stack-protector \
          -Wall \
          -Wno-unused-variable \
          -Wextra \
          -MMD -MP \
          $(INCLUDES)

NASMFLAGS := -f elf64 -g -F dwarf

LDFLAGS := -T linker.ld -nostdlib -static

# Source Files
C_SRCS := kernel/kmain.c \
          kernel/cpuid.c \
          kernel/gdt.c \
          kernel/idt.c \
          kernel/isr.c \
          kernel/pic.c \
          kernel/syscall.c \
          kernel/sys_dispatch.c \
          kernel/sys_names.c \
          kernel/memory/pmm.c \
          kernel/memory/pmap.c \
          kernel/memory/vm_map.c \
          kernel/kmalloc.c \
          lib/stdlib/string.c \
          lib/stdlib/libkernel.c \
          kernel/drivers/framebuffer.c \
          kernel/ipc/ipc_object.c \
          kernel/ipc/ipc_port.c \
          kernel/ipc/ipc_space.c \
          kernel/ipc/mach_message.c \
          kernel/ipc/mach_traps.c \
          kernel/ipc/thread.c \
          kernel/ipc/task.c \
          kernel/mach/loader.c \
          kernel/initrd.c \
          kernel/bsd/syscalls.c \
          kernel/task.c
          
ASM_SRCS := kernel/asm/entry.asm \
            kernel/asm/load_gdt.asm \
            kernel/asm/int.asm \
            kernel/asm/syscall_entry.asm \
            kernel/asm/tss_ring3.asm

# Map sources to object files in build directory
OBJS := $(addprefix $(BUILD_DIR)/,$(C_SRCS:.c=.o)) \
        $(addprefix $(BUILD_DIR)/,$(ASM_SRCS:.asm=.o))

DEPS := $(addprefix $(BUILD_DIR)/,$(C_SRCS:.c=.d))

# Libgcc path lookup for freestanding 64-bit divide/stubs
LIBGCC := $(shell $(CC) -print-libgcc-file-name)

# These sources are generated by make_syscalls.rb
SYSCALL_GENERATED := kernel/sys_enter.h \
                     kernel/sys_dispatch.h \
                     kernel/sys_dispatch.c \
                     kernel/sys_names.c

$(SYSCALL_GENERATED) &: scripts/make_syscalls.rb kernel/syscalls.master
	$(RUBY) scripts/make_syscalls.rb kernel/syscalls.master

$(BUILD_DIR)/kernel/syscall.o $(BUILD_DIR)/kernel/sys_dispatch.o \
$(BUILD_DIR)/kernel/sys_names.o $(BUILD_DIR)/kernel/bsd/syscalls.o: $(SYSCALL_GENERATED)

# Targets
.PHONY: all iso limine_bootloader qemu initrd clean test-ipc test-syscalls

all: iso

initrd:
	$(RUBY) scripts/make_initrd.rb

# Compile C sources
$(BUILD_DIR)/%.o: %.c Makefile
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Assemble NASM sources
$(BUILD_DIR)/%.o: %.asm
	@mkdir -p $(dir $@)
	$(NASM) $(NASMFLAGS) $< -o $@

# Link Executable
$(TARGET_ELF): $(OBJS)
	@mkdir -p $(BUILD_DIR)
	$(LD) $(LDFLAGS) $(OBJS) $(LIBGCC) -o $@

# Limine Bootloader target
limine:
	@mkdir -p $(LIMINE_DIR)
	LIMINE_DIR="$(LIMINE_DIR)" $(BASH) scripts/build_limine.sh

# Build ISO target
iso: $(TARGET_ELF) limine
	@mkdir -p $(ISO_DIR)/boot
	cp $(TARGET_ELF) $(ISO_DIR)/boot/kernel.elf
	cp $(LIMINE_DIR)/limine-bios.sys $(ISO_DIR)/
	cp $(LIMINE_DIR)/limine-bios-cd.bin $(ISO_DIR)/
	cp limine.conf $(ISO_DIR)/
	$(XORRISO) -as mkisofs -b limine-bios-cd.bin \
		-no-emul-boot -boot-load-size 4 -boot-info-table \
		$(ISO_DIR) -o $(TARGET_ISO)
	$(LIMINE_DIR)/limine bios-install $(TARGET_ISO)

# QEMU target
qemu: iso
	$(QEMU) -cdrom $(TARGET_ISO) \
		-m 512M \
		-gdb tcp:127.0.0.1:1234 \
		-debugcon stdio \
		-no-reboot -no-shutdown \
		-d int,cpu_reset \
		-D qemu.log

# Clean build artifacts
test-ipc:
	@mkdir -p $(BUILD_DIR)/tests
	$(CC) -std=c17 -Wall -Wextra -Werror -Wno-unused-parameter -fno-builtin \
		-I. -Iinclude -Ilib -Ilib/stdlib -Ikernel -Ikernel/memory \
		tests/ipc_object_test.c kernel/ipc/ipc_object.c \
		kernel/ipc/ipc_port.c kernel/ipc/ipc_space.c \
		kernel/ipc/mach_message.c kernel/ipc/mach_traps.c \
		-o $(BUILD_DIR)/tests/ipc_object_test
	$(BUILD_DIR)/tests/ipc_object_test

test-syscalls:
	$(RUBY) tests/make_syscalls_test.rb

clean:
	rm -rf $(BUILD_DIR)

-include $(DEPS)